@{
    ViewData["Title"] = "Page Not Found";
}

<div class="text-center mt-5">
    <h1 style="font-size: 8rem; color: #FBBF24;">404</h1>
    <h2>Oops! Page Not Found</h2>
    <p class="mt-3">The page you are looking for doesn't exist or has been moved.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-dark mt-4 rounded-pill px-4">
        ← Back to Home
    </a>
</div>