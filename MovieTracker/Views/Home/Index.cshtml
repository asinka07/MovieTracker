@model MovieTracker.ViewModels.Home.HomeViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<div class="home-header">
    <h1>MovieTracker</h1>
    <h3>Your Movie Space</h3>

    <div class="home-buttons">
        @if (User.IsInRole("Administrator"))
        {
            <a asp-area="Admin" asp-controller="Movies" asp-action="Index" class="btn btn-dark">Movies</a>
            <a asp-area="Admin" asp-controller="Genres" asp-action="Index" class="btn btn-outline-dark">Genres</a>
        }
        else
        {
            <a asp-controller="Movies" asp-action="Index" class="btn btn-dark">Browse Movies</a>
            <a asp-controller="Genres" asp-action="Index" class="btn btn-outline-dark">Genres</a>
        }
    </div>
</div>

<div class="home-section">
    @if (User.IsInRole("Administrator"))
    {
        <p>Welcome back, Admin! Manage the movie collection, approve pending submissions...</p>
        <p>Use the navigation menu to manage movies, genres, directors, and users.</p>
    }
    else if (User.Identity.IsAuthenticated)
    {
        <p>Welcome back! Browse the movie collection, add new titles, write reviews...</p>
        <p>Added a movie? It will be reviewed by an admin before it appears in the collection.</p>
    }
    else
    {
        <p>MovieTracker is a shared space where movie lovers can discover and explore titles...</p>
        <p>Login or register to start adding movies, writing reviews, and building the collection.</p>
    }
</div>

<div class="home-section">
    <h2>Latest Published Movies</h2>

    @if (!Model.LatestMovies.Any())
    {
        <p>No movies added yet.</p>
    }
    else
    {
        <div class="movies-grid">
            @foreach (var movie in Model.LatestMovies)
            {
                <div class="movie-card">
                    <div class="movie-poster">
                        <span class="poster-icon">&#127916;</span>
                    </div>
                    <div class="movie-content">
                        <h5>@movie.Title</h5>
                        <span class="genre-badge">@movie.GenreName</span>
                        <a href="@Url.Action("DetailsModal", "Movies", new { id = movie.Id })" class="details-btn open-modal">View Details</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="home-section">
    <h2>&#127942; Top Genres – Genres with Most Movies</h2>
    <div class="genres-ranking">
        @for (int i = 0; i < Model.TopGenres.Count; i++)
        {
            var genre = Model.TopGenres[i];
            <span class="genre-rank">
                <span class="rank-icon">
                    @(i == 0 ? Html.Raw("&#x1F947;") : i == 1 ? Html.Raw("&#129352;") : i == 2 ? Html.Raw("&#129353;") : Html.Raw("&#127916;"))
                </span>
                @if (User.IsInRole("Administrator"))
                {
                    <a asp-area="Admin" asp-controller="Movies" asp-action="Index" asp-route-genreId="@genre.Id" class="genre-tag">
                        @genre.Name <span class="genre-count">@genre.MoviesCount</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Movies" asp-action="Index" asp-route-genreId="@genre.Id" class="genre-tag">
                        @genre.Name <span class="genre-count">@genre.MoviesCount</span>
                    </a>
                }
            </span>
        }
    </div>
</div>
<div class="modal fade" id="movieModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content p-3" id="movieModalContent">
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".open-modal").forEach(button => {
                button.addEventListener("click", function(e) {
                    e.preventDefault();
                    const url = this.getAttribute("href");
                    fetch(url)
                        .then(res => res.text())
                        .then(html => {
                            const modalContent = document.getElementById("movieModalContent");
                            modalContent.innerHTML = html;
                            const modalEl = document.getElementById("movieModal");
                            const modal = new bootstrap.Modal(modalEl);
                            modal.show();
                        });
                });
            });
        });
    </script>
}