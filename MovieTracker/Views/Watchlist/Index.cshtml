@using MovieTracker.ViewModels.Watchlist
@model IEnumerable<WatchlistViewModel>
@{
    ViewData["Title"] = "My Watchlist";
}
@section Styles {
    <link rel="stylesheet" href="~/css/movies.css" />
}

<h1 class="mb-5">My Watchlist</h1>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <span style="font-size: 80px;">&#127916;</span>
        <h3 class="mt-3">Your watchlist is empty</h3>
        <p style="color: rgba(255, 255, 255, 0.5);">Start adding movies you want to watch later.</p>
        <a asp-controller="Movies" asp-action="Index" class="btn btn-dark mt-3 rounded-pill px-4">
            Browse Movies
        </a>
    </div>
}
else
{
    <div class="movies-grid">
        @foreach (var movie in Model)
        {
            <div class="movie-card">
                <h6>@movie.Title</h6>
                <div class="movie">
                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" class="bi bi-film" viewBox="0 0 16 16">
                        <path d="M0 1a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm4 0v6h8V1zm8 8H4v6h8zM1 1v2h2V1zm2 3H1v2h2zM1 7v2h2V7zm2 3H1v2h2zm-2 3v2h2v-2zM15 1h-2v2h2zm-2 3v2h2V4zm2 3h-2v2h2zm-2 3v2h2v-2zm2 3h-2v2h2z" />
                    </svg>
                    <div class="movie-info">
                        <p class="genre">Genre: @movie.GenreName</p>
                        <p class="year">Added: @movie.AddedOn.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-2">
                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId"
                       class="btn-info my-btn">Details</a>
                    <form asp-controller="Watchlist" asp-action="Remove" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="movieId" value="@movie.MovieId" />
                        <button type="submit" class="my-btn" style="color: #ff6b6b; background: none; border: none;">
                            Remove
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var message = '@TempData["SuccessMessage"]';
            if (message) {
                toastr.success(message);
            }
        });
    </script>
}