@using MovieTracker.ViewModels.Movies
@model IEnumerable<MoviePartialViewModel>

@{
    ViewData["Title"] = "Pending Approval";
}

<h1 class="mb-5">Pending Approval</h1>

@if (!Model.Any())
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i> No movies pending approval!
    </div>
}
else
{
    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Description</th>
                <th>Added By</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@movie.GenreName</td>
                    <td>
                        @if (!string.IsNullOrEmpty(movie.Description))
                        {
                            @(movie.Description.Length > 80
                                ? movie.Description.Substring(0, 80) + "..."
                                : movie.Description)
                        }
                    </td>
                    <td>@movie.AddedByUserName</td>
                    <td>@movie.Published.ToString("dd MMM yyyy")</td>
                    <td>
                        <a asp-area="Admin" asp-controller="Movies" asp-action="Details"
                               asp-route-id="@movie.Id"
                               class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye"></i> Review
                        </a>
                        <form asp-area="Admin" asp-controller="Movies" asp-action="Approve" method="post" class="d-inline">
                            <input type="hidden" name="movieId" value="@movie.Id" />
                            <input type="hidden" name="returnAction" value="Pending" />
                            <button type="submit" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-check-lg"></i> Approve
                            </button>
                        </form>
                        <form asp-area="Admin" asp-controller="Movies" asp-action="DeleteConfirmed" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@movie.Id" />
                            <input type="hidden" name="returnAction" value="Pending" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Are you sure you want to delete this movie?')">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var message = '@TempData["SuccessMessage"]';
            if (message) {
                toastr.success(message);
            }
        });
    </script>
}