@using MovieTracker.ViewModels.Movies
@model MovieTracker.ViewModels.Movies.MovieIndexViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/movies.css" />
}

@{
    ViewData["Title"] = "Manage Movies";
}

<h1 class="mb-5">Manage Movies</h1>

<a asp-area="Admin" asp-action="Create" class="btn btn-dark mb-4">
    + Add Movie
</a>

<form method="get" class="row g-3 mb-4 align-items-end">
    <div class="col-md-4">
        <label asp-for="GenreId" class="form-label">Filter by Genre</label>
        <select asp-for="GenreId" asp-items="Model.Genres" class="form-select">
            <option value="">All Genres</option>
        </select>
    </div>

    <div class="col-md-4">
        <label asp-for="SortedMovies" class="form-label">Sort by Date</label>
        <select name="sortedMovies" class="form-select">
            <option value="">Oldest first</option>
            <option value="date_desc" selected="@(Model.SortedMovies == "date_desc")">Newest first</option>
        </select>
    </div>

    <div class="col-md-4">
        <button type="submit" class="btn btn-dark w-100 mt-4">Apply</button>
    </div>
</form>

@if (!Model.Movies.Any())
{
    <p>No movies found.</p>
}
else
{
    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Added By</th>
                <th>Published</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model.Movies)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@movie.GenreName</td>
                    <td>@movie.AddedByUserName</td>
                    <td>@movie.Published.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (movie.IsApproved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Admin" asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-warning">Edit</a>

                        @if (!movie.IsApproved)
                        {
                            <form asp-area="Admin" asp-action="Approve" method="post" class="d-inline">
                                <input type="hidden" name="movieId" value="@movie.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                            </form>
                        }

                        <form asp-area="Admin" asp-action="DeleteConfirmed" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@movie.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Are you sure?')">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var message = '@TempData["SuccessMessage"]';
            if (message) {
                toastr.success(message);
            }
        });
    </script>
}