@using MovieTracker.ViewModels.Admin
@model UserDetailsViewModel

@{
    ViewData["Title"] = $"User Details - {Model.UserName}";
}

<h1 class="mb-5">User Details</h1>

<div class="card bg-dark text-light border-secondary">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <h5 class="text-secondary">Email</h5>
                <p>@Model.Email</p>
            </div>
            <div class="col-md-6">
                <h5 class="text-secondary">Username</h5>
                <p>@Model.UserName</p>
            </div>
            <div class="col-md-6">
                <h5 class="text-secondary">Role</h5>
                @if (Model.Role == "Administrator")
                {
                    <span class="badge bg-warning text-dark">Administrator</span>
                }
                else
                {
                    <span class="badge bg-secondary">User</span>
                }
            </div>
            <div class="col-md-6">
                <h5 class="text-secondary">Email Confirmed</h5>
                @if (Model.EmailConfirmed)
                {
                    <span class="badge bg-success">Confirmed</span>
                }
                else
                {
                    <span class="badge bg-danger">Unconfirmed</span>
                }
            </div>
            <div class="col-md-6">
                <h5 class="text-secondary">Movies Added</h5>
                <h3 class="fw-bold">@Model.MoviesCount</h3>
            </div>
            <div class="col-md-6">
                <h5 class="text-secondary">Reviews Written</h5>
                <h3 class="fw-bold">@Model.ReviewsCount</h3>
            </div>
        </div>
    </div>
</div>

<a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary mt-4">
    Back to Users
</a>