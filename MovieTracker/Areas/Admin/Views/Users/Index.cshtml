@using MovieTracker.ViewModels.Admin
@model IEnumerable<UserDetailsViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<h1 class="mb-5">Manage Users</h1>

@if (!Model.Any())
{
    <p>No users found.</p>
}
else
{
    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Email</th>
                <th>Username</th>
                <th>Role</th>
                <th>Movies</th>
                <th>Reviews</th>
                <th>Email Confirmed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                    <td>
                        @if (user.Role == "Administrator")
                        {
                            <span class="badge bg-warning text-dark">Administrator</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">User</span>
                        }
                    </td>
                    <td>@user.MoviesCount</td>
                    <td>@user.ReviewsCount</td>
                    <td>
                        @if (user.EmailConfirmed)
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unconfirmed</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Details"
                               asp-route-userId="@user.Id"
                               class="btn btn-sm btn-outline-info">
                            <i class="bi bi-person"></i> Details
                        </a>

                        @if (user.Role != "Administrator")
                        {
                            <form asp-area="Admin" asp-controller="Users" asp-action="Promote" method="post" class="d-inline">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-arrow-up-circle"></i> Promote
                                </button>
                            </form>

                            <form asp-area="Admin" asp-controller="Users" asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Are you sure?')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-area="Admin" asp-controller="Users" asp-action="Demote" method="post" class="d-inline">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-arrow-down-circle"></i> Demote
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var message = '@TempData["SuccessMessage"]';
            if (message) {
                toastr.success(message);
            }
            var error = '@TempData["ErrorMessage"]';
            if (error) {
                toastr.error(error);
            }
        });
    </script>
}