@page
@model LoginModel

@{
	ViewData["Title"] = "Log in";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg" style="background-color: #1f2937; border-radius: 20px; overflow: hidden;">
                
                <div class="card-header py-4 text-center border-0" style="background-color: #111827;">
                    <h2 class="fw-bold mb-0 text-uppercase" style="color: #f3f4f6; letter-spacing: 2px; font-family: fantasy;">
                        @ViewData["Title"]
                    </h2>
                </div>

                <div class="card-body p-5">
                    <form id="account" method="post">                        
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label small fw-bold text-uppercase" style="color: #fbbf24;">Username or email address</label>
                            <input asp-for="Input.Email" class="form-control border-0 py-3 px-3 shadow-none"
                                   style="background-color: #374151; color: #fff; border-radius: 10px;"
                                   placeholder="Username or email" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label small fw-bold text-uppercase" style="color: #fbbf24;">Password</label>
                            <input asp-for="Input.Password" class="form-control border-0 py-3 px-3 shadow-none"
                                   style="background-color: #374151; color: #fff; border-radius: 10px;"
                                   placeholder="&#9679;&#9679;&#9679;&#9679;&#9679;" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input shadow-none" asp-for="Input.RememberMe" style="background-color: #374151; border: none;" />
                                <label asp-for="Input.RememberMe" class="form-check-label small" style="color: lightgray;">
                                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                                </label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none fw-bold" style="color: #fbbf24;">Forgot password?</a>
                        </div>
                        <button id="login-submit" type="submit" class="w-100 btn py-3 fw-bold text-uppercase shadow"
                                style="background-color: #fbbf24; color: #111827; border-radius: 999px; transition: all 0.3s ease;">
                            Log in
                        </button>
                        <div class="mt-4 text-center">
                            <p class="mb-1" style="color: lightgray;">
                                <span class="small">Don't have an account?</span>
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none" style="color: #fbbf24;">Register now</a>
                            </p>
                            <p>
                                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="small text-decoration-none" style="color: lightgray; opacity: 0.7;">Resend email confirmation</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
